# Copy to .env and fill in — .env is gitignored and never committed.
# Get keys: alpaca.markets → Paper Trading → API Keys → Generate
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Live trading requires an explicit "false". Anything else means paper.
ALPACA_PAPER=true

# Data feeds — free tiers by default. With the paid Alpaca market-data
# subscription: sip (full consolidated tape) / opra (full options NBBO).
ALPACA_STOCK_FEED=iex
ALPACA_OPTION_FEED=indicative

# Critical-event alerting (kill switches, exit failures, reconciliation
# mismatches, watchdog restarts). Configure at least one channel for live
# trading — an unattended bot must be able to reach you.
# Webhook: JSON POST {"text": ...} — Slack-compatible; for Discord append
# /slack to the webhook URL.
ALERT_WEBHOOK_URL=
# Email (stdlib SMTP; STARTTLS when user/pass given)
ALERT_EMAIL_TO=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
